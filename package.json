{
  "name": "teehub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:woocommerce": "esbuild scripts/migrate-woocommerce.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.migrate-woocommerce.mjs && node --env-file=.env scripts/.migrate-woocommerce.mjs",
    "migrate:woocommerce:dry": "npm run migrate:woocommerce -- --dry-run",
    "migrate:woocommerce:restart": "npm run migrate:woocommerce -- --restart",
    "sync:woocommerce:orders": "npm run migrate:woocommerce -- --orders-only",
    "sync:woocommerce:customers": "esbuild scripts/sync-woocommerce-customers.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.sync-woocommerce-customers.mjs && node --env-file=.env scripts/.sync-woocommerce-customers.mjs",
    "sync:woocommerce:products": "esbuild scripts/sync-woocommerce-products.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.sync-woocommerce-products.mjs && node --env-file=.env scripts/.sync-woocommerce-products.mjs",
    "repair:woocommerce": "esbuild scripts/repair-woocommerce.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.repair-woocommerce.mjs && node --env-file=.env scripts/.repair-woocommerce.mjs",
    "verify:woocommerce": "esbuild scripts/verify-woocommerce.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.verify-woocommerce.mjs && node --env-file=.env scripts/.verify-woocommerce.mjs",
    "test:woocommerce": "esbuild scripts/woocommerce.test.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.woocommerce.test.mjs && node --test scripts/.woocommerce.test.mjs",
    "sweep:payments": "esbuild scripts/sweep-abandoned-payments.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.sweep-abandoned-payments.mjs && node --env-file=.env scripts/.sweep-abandoned-payments.mjs",
    "sweep:payments:dry": "npm run sweep:payments -- --dry-run",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate": "payload migrate",
    "generate:types": "esbuild scripts/gen-types.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.gentypes.compiled.mjs && node --env-file=.env scripts/.gentypes.compiled.mjs",
    "generate:importmap": "esbuild scripts/gen-importmap.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.importmap.compiled.mjs && node --env-file=.env scripts/.importmap.compiled.mjs"
  },
  "dependencies": {
    "@deemlol/next-icons": "^0.2.7",
    "@payloadcms/db-postgres": "^3.85.1",
    "@payloadcms/next": "^3.85.1",
    "@payloadcms/plugin-seo": "^3.85.1",
    "@payloadcms/richtext-lexical": "^3.85.1",
    "@payloadcms/storage-s3": "^3.85.1",
    "@payloadcms/ui": "3.85.1",
    "@tabler/icons-react": "^3.44.0",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.44.7",
    "graphql": "^16.14.2",
    "next": "16.2.7",
    "payload": "^3.85.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
