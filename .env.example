DATABASE_URI=postgresql://user:password@localhost:5432/teehub
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-public-domain.example

# HDFC SmartGateway. Keep the raw API key server-side; never prefix these with
# NEXT_PUBLIC_. Use "uat" until HDFC approves the production switch.
HDFC_SMARTGATEWAY_ENV=uat
HDFC_SMARTGATEWAY_MERCHANT_ID=
HDFC_SMARTGATEWAY_API_KEY=
HDFC_SMARTGATEWAY_CLIENT_ID=hdfcmaster
HDFC_SMARTGATEWAY_RESELLER_ID=hdfc_reseller
HDFC_SMARTGATEWAY_RETURN_URL=https://your-public-domain.example/checkout/payment/return
HDFC_SMARTGATEWAY_WEBHOOK_USERNAME=
HDFC_SMARTGATEWAY_WEBHOOK_PASSWORD=

# Optional email configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@teehubshop.com
RESEND_FROM_NAME=TeeHub

# Optional S3-compatible media storage
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
